PinkUnicorn__HistoryRewrite__Protocol=OpenAIChatCompletions
PinkUnicorn__HistoryRewrite__Endpoint=https://api.openai.com/v1/chat/completions
PinkUnicorn__HistoryRewrite__Model=your-lightweight-model
PinkUnicorn__HistoryRewrite__ApiKey=replace-me
PinkUnicorn__HistoryRewrite__OpenAIOutputTokenParameter=MaxCompletionTokens

# Durable exact-replay cache. Relative paths resolve from the application content root.
# PinkUnicorn__HistoryRewrite__Cache__DatabasePath=data/pink-unicorn-cache.db
# Increment this to start a new cache namespace without deleting the old database.
PinkUnicorn__HistoryRewrite__Cache__Generation=1

# Optional proxy-local authentication for non-loopback deployments.
# PinkUnicorn__AccessToken=replace-with-at-least-16-random-characters
