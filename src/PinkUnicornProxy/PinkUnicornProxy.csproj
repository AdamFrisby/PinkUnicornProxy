<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>PinkUnicornProxy</RootNamespace>
    <AssemblyName>PinkUnicornProxy</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Adam Frisby</Authors>
    <Description>A provider-aware OpenAI and Anthropic reverse proxy that rewrites corrected assumptions out of conversation history.</Description>
    <RepositoryUrl>https://github.com/AdamFrisby/PinkUnicornProxy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PinkUnicornProxy.Tests" />
  </ItemGroup>
</Project>
